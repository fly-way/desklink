{
  "name": "desklink",
  "version": "0.3.4",
  "private": true,
  "description": "Windows MCP gateway that securely connects ChatGPT to local tools and desktop applications over OpenAI Secure MCP Tunnel",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run icon && tsc",
    "test": "npm run build && node --test test/*.test.js",
    "icon": "node tools/make-icon.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "app.desklink",
    "productName": "DeskLink",
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeskLink"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "pe-library": "^0.4.1",
    "resedit": "^1.7.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@modelcontextprotocol/server": "^2.1.0",
    "express": "^5.2.1"
  }
}
